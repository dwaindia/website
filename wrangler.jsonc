{
  "name": "website",
  "main": "workers/form-api/index.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://dwaindiaa.org,https://www.dwaindiaa.org,http://localhost:8787,http://localhost:8080,http://127.0.0.1:8787",
    "NOTIFICATION_EMAIL": "dalitwelfareassociation1@gmail.com",
    "SENDER_EMAIL": "forms@notify.dwaindiaa.org",
    "SENDER_NAME": "Dalit Welfare Association Website"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "dwa-submissions",
      "database_id": "65a2e47f-e25f-4904-922e-a08f207a0a60"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "dalitwelfareassociation1@gmail.com"
    }
  ]
}
